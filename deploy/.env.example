# deploy/.env 로 복사해서 쓴다 (gitignore 대상). 비밀값은 openssl rand -base64 32 로 새로 만든다.
POSTGRES_PASSWORD=
ACADEMY_AUTH_SECRET=
ADMIN_AUTH_SECRET=

ACADEMY_URL=http://localhost:4100
ADMIN_URL=http://localhost:4200
ACADEMY_PORT=4100
ADMIN_PORT=4200
MEDIA_PORT=4300

# media 서버가 서빙할 로컬 폴더
VIDEO_DIR=C:/Users/SIMJAE/Downloads/bestcareacademy_video_backup_2026-10-28/web_faststart
UPLOADS_DIR=D:/dev/clients/bayada/bestcareacademy-restore/wp-content/uploads

# 토스페이먼츠 (결제위젯 연동 키 · 결제창형). 아래는 토스 공식 문서·샘플에 공개된 테스트 키(실제 결제 안 됨).
# 운영 전환 시 개발자센터 > API 키 > 결제위젯 연동 키의 live_gck_ / live_gsk_ 로 바꾼다. 시크릿 키는 절대 커밋하지 말 것.
# 운영(NODE_ENV=production)에서는 값이 없으면 결제·환불을 막는다.
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# 메일 (비밀번호 재설정·이메일 인증·기관 초대·인증 갱신 안내). 비워 두면 compose 의 mailpit(smtp://mailpit:1025, 수신함 http://localhost:8025)으로 간다.
# 운영 예: SMTP_URL=smtps://USER:PASS@email-smtp.ap-northeast-2.amazonaws.com:465 (AWS SES SMTP)
# 개발 서버(pnpm dev)는 apps/{academy,admin}/.env.local 에 SMTP_URL=smtp://localhost:1025 — 없으면 메일 대신 서버 로그에 링크를 찍는다.
SMTP_URL=
MAIL_FROM=BAYADA Academy <no-reply@bayada.co.kr>

# 소셜 로그인 (학습자 사이트만). 키가 있는 제공자만 로그인 화면에 버튼이 보인다.
# 콜백 URL 등록: {ACADEMY_URL}/api/auth/callback/kakao · {ACADEMY_URL}/api/auth/callback/google
# 카카오는 동의항목에 "카카오계정(이메일)" 이 있어야 기존 계정과 연결된다(없으면 이메일 없는 새 계정).
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 인증 갱신 안내 메일: 하루 한 번 아래를 호출 (호스트 cron·EventBridge 등)
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" $ACADEMY_URL/api/cron/credential-renewals
CRON_SECRET=
