# deploy/ec2/.env (서버에만 둔다, gitignore). 비밀값: openssl rand -base64 32
# 도메인이 생기면 *_HOST 만 바꾸고 up -d --build (NEXT_PUBLIC_SITE_URL 이 빌드에 박히므로 재빌드 필요)
# 도메인 전에는 고정 IP 기반 sslip.io 이름을 쓴다 (예: academy.54-116-157-4.sslip.io)
WEB_HOST=
ACADEMY_HOST=
ADMIN_HOST=
MEDIA_HOST=
ACME_EMAIL=

POSTGRES_PASSWORD=
ACADEMY_AUTH_SECRET=
ADMIN_AUTH_SECRET=
# 홈페이지 회원 로그인(마이페이지) 세션 서명 — academy·admin 과 다른 값
WEB_AUTH_SECRET=
CRON_SECRET=
# 어드민 → 홈페이지 재생성(POST /api/revalidate) 비밀값 — web·admin 이 같은 값을 쓴다
WEB_REVALIDATE_SECRET=

TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
SMTP_URL=
MAIL_FROM=BAYADA Academy <no-reply@bayada.co.kr>
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 클라이언트 검수용 리뷰 모드 (web·academy). 둘 다 있어야 켜진다. 검수가 끝나면 비우고 up -d (재빌드 불필요)
#   잠금 해제: https://${WEB_HOST}/review-access , https://${ACADEMY_HOST}/review-access
REVIEW_ACCESS_PASSWORD=
REVIEW_ACCESS_SECRET=
# 레슨 영상 서명 주소 비밀값 (openssl rand -hex 32). 없으면 compose 가 시작을 거부한다
MEDIA_SIGNING_SECRET=
