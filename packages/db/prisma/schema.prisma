generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"] // rhel=Vercel, debian=Docker(node:22-slim)
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 사용자 ───
model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String?
  password               String // bcrypt hash
  role                   Role                    @default(STUDENT)
  status                 UserStatus              @default(APPROVED) // 사내 가입 승인 (New User Approve 이관)
  jobRole                JobRole? // 대상 직군 (최초 로그인 시 수집)
  phone                  String?
  legacyWpId             Int?                    @unique // bestcareacademy.com wp_users.ID
  organizationId         String?
  organization           Organization?           @relation(fields: [organizationId], references: [id])
  enrollments            Enrollment[]
  progresses             Progress[]
  orders                 Order[]
  quizAttempts           QuizAttempt[]
  certificates           Certificate[]
  wishlist               Wishlist[]
  credentialApplications CredentialApplication[] @relation("Applicant")
  credentialEvaluations  CredentialApplication[] @relation("Evaluator")
  credentials            Credential[]
  subscriptions          Subscription[]
  pathwayGoals           PathwayGoal[]
  reviews                Review[]
  sessionRegistrations   SessionRegistration[]
  assignments            CourseAssignment[]      @relation("AssignmentLearner")
  providerId             String? // PARTNER_ADMIN 이 관리하는 제공기관
  customRoleKey          String? // 어드민 사용자 정의 역할 (AdminRoleDef.key). 있으면 role 대신 이 역할의 권한을 쓴다
  provider               Provider?               @relation(fields: [providerId], references: [id])
  passwordChangedAt      DateTime? // 비밀번호 재설정 시각 — 이전에 발급된 세션(JWT)은 무효
  emailVerifiedAt        DateTime? // 이메일 인증 완료 (외부 가입은 선택, 로그인은 막지 않음)
  authTokens             AuthToken[]
  socialAccounts         SocialAccount[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

// 피그마 설계 택소노미 1차 축
enum JobRole {
  CAREGIVER // 요양보호사·간병인
  NURSE_AIDE // 간호조무사
  RN // 간호사
  PT // 방문운동사
  MANAGER // 센터 관리자
  OTHER
}

enum Role {
  ADMIN
  STUDENT
  ORG_ADMIN
  CONTENT_MANAGER // 콘텐츠 운영자
  CLINICAL_REVIEWER // 임상 리뷰어
  PARTNER_ADMIN // 외부 파트너 관리자
}

// ─── 기관 (B2B) ───
model Organization {
  id          String             @id @default(cuid())
  name        String
  bizNo       String? // 사업자등록번호
  contact     String? // 담당자 연락처
  isInternal  Boolean            @default(false) // 바야다 사내 조직. 소속 회원만 INTERNAL 강의를 본다
  assignments CourseAssignment[]
  invites     OrgInvite[]
  users       User[]
  orders      Order[]
  createdAt   DateTime           @default(now())
}

// ─── 강의 ───
model Course {
  id           String             @id @default(cuid())
  title        String
  slug         String             @unique
  description  String?            @db.Text
  summary      String? // 카드용 한 줄 소개
  thumbnail    String? // URL
  price        Int                @default(0) // 원 단위
  status       CourseStatus       @default(DRAFT)
  visibility   Visibility         @default(PUBLIC)
  productType  ProductType        @default(COURSE)
  level        Level?
  learningMode LearningMode       @default(ONLINE)
  durationMin  Int? // 총 학습 시간(분)
  audiences    JobRole[] // 대상 직군
  objectives   String[] // 학습 목표
  featured     Boolean            @default(false) // 메인 신규·인기 큐레이션
  categoryId   String?
  category     Category?          @relation(fields: [categoryId], references: [id])
  providerId   String?
  provider     Provider?          @relation(fields: [providerId], references: [id])
  sections     Section[]
  enrollments  Enrollment[]
  orderItems   OrderItem[]
  certificates Certificate[]
  wishlist     Wishlist[]
  pathwaySteps PathwayStep[]
  reviews      Review[]
  sessions     TrainingSession[]
  assignments  CourseAssignment[]
  reviewNote   String?            @db.Text // 승인 워크플로우 수정 요청 사유
  legacyWpId   Int?               @unique // wp_posts.ID (stm-courses)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// 사내 전용(직원 의무교육) vs 외부 공개
enum Visibility {
  PUBLIC
  INTERNAL
}

enum ProductType {
  COURSE // 단과
  TRACK // 스킬 트랙
  CERTIFICATION // 바야다 인증과정
  PATHWAY // 커리어 패스웨이
}

enum LearningMode {
  ONLINE
  BLENDED // 온라인 + 실습
  OFFLINE
  LIVE
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ─── 제공 기관 (바야다 자체 + 외부 파트너) ───
model Provider {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  isPartner   Boolean  @default(false)
  description String?  @db.Text
  admins      User[]
  courses     Course[]
  createdAt   DateTime @default(now())
}

// 승인 워크플로우 상태 머신 (피그마 04)
enum CourseStatus {
  DRAFT
  SUBMITTED // 승인 요청
  IN_REVIEW // 형식·품질 검토
  CLINICAL_REVIEW // 임상 근거 검토
  CHANGES_REQUESTED // 수정 요청
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  order   Int      @default(0)
  courses Course[]
}

// ─── 섹션 & 레슨 ───
model Section {
  id         String    @id @default(cuid())
  title      String
  order      Int
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures   Lecture[]
  legacyWpId Int?      @unique // stm_lms_curriculum_sections.id
}

model Lecture {
  id         String      @id @default(cuid())
  title      String
  order      Int
  type       LectureType @default(VIDEO)
  videoUrl   String? // 영상 URL (S3/R2)
  content    String?     @db.Text // TEXT 레슨 본문
  duration   Int? // 초 단위
  isFree     Boolean     @default(false) // 무료 미리보기
  sectionId  String
  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  quiz       Quiz?
  progresses Progress[]
  legacyWpId Int? // wp_posts.ID (stm-lessons / stm-quizzes). 같은 레슨이 여러 강의에 쓰여 unique 아님
}

enum LectureType {
  VIDEO
  TEXT
  QUIZ
}

// ─── 퀴즈 ───
model Quiz {
  id           String        @id @default(cuid())
  lectureId    String        @unique
  lecture      Lecture       @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  passingScore Int           @default(80) // %
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id         String       @id @default(cuid())
  quizId     String
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order      Int
  type       QuestionType @default(SINGLE)
  text       String       @db.Text
  options    Json // [{ text, correct }]
  legacyWpId Int? // stm-questions
}

enum QuestionType {
  SINGLE
  MULTI
  TRUE_FALSE
  FILL_GAP // 본문의 |정답| 을 빈칸으로
  KEYWORDS // 키워드 입력
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  user      User     @relation(fields: [userId], references: [id])
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int // %
  passed    Boolean
  createdAt DateTime @default(now())
}

// ─── 수강 ───
model Enrollment {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  user            User      @relation(fields: [userId], references: [id])
  course          Course    @relation(fields: [courseId], references: [id])
  progressPercent Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([userId, courseId])
}

// ─── 수료증 ───
model Certificate {
  id        String    @id @default(cuid())
  number    String    @unique // 공개 검증용 번호 BA-2026-000123
  userId    String
  courseId  String
  user      User      @relation(fields: [userId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id])
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  @@unique([userId, courseId])
}

// ─── 메인 배너 (노출 기간 필수) ───
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  linkUrl   String?
  startsAt  DateTime
  endsAt    DateTime
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── 감사 로그 ───
model AuditLog {
  id      String   @id @default(cuid())
  actorId String?
  action  String // course.submit, course.approve ...
  target  String // Course:ckxxx
  detail  Json?
  at      DateTime @default(now())

  @@index([target])
}

// 어드민 역할·권한 정의 — 시스템 역할(Role enum 의 운영 역할)도 행으로 두고 권한만 바꾼다.
// isSystem=true 행은 key 가 Role enum 값과 같고 삭제·이름 변경 불가. ADMIN 은 코드에서 항상 전체 권한(잠금).
model AdminRoleDef {
  id          String   @id @default(cuid())
  key         String   @unique // ADMIN, CONTENT_MANAGER … 또는 사용자 정의 키(custom_xxx)
  name        String
  description String   @default("")
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 학습자 사이트 문구·설정 (어드민 '사이트 설정'). 섹션별 key 한 행씩 — @bayada/shared/site-settings 참고
model SiteSetting {
  key       String   @id // home.hero, home.sections, faq, footer, inquiry, seo
  value     Json
  updatedAt DateTime @updatedAt
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  lectureId   String
  completed   Boolean   @default(false)
  completedAt DateTime?
  watchedSec  Int       @default(0) // 시청 초
  user        User      @relation(fields: [userId], references: [id])
  lecture     Lecture   @relation(fields: [lectureId], references: [id])
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lectureId])
}

// ─── 주문 & 빌링 ───
model Order {
  id             String        @id @default(cuid())
  orderNo        String        @unique // ORD-20250301-001
  userId         String
  organizationId String?
  user           User          @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  type           OrderType     @default(B2C)
  status         OrderStatus   @default(PENDING)
  totalAmount    Int           @default(0)
  paymentKey     String?       @unique // 토스페이먼츠 결제 키
  paymentMethod  String?
  paidAt         DateTime?
  refundedAt     DateTime?
  refundAmount   Int?
  refundReason   String?
  subscription   Subscription?
  items          OrderItem[]
  invoice        Invoice?
  createdAt      DateTime      @default(now())
}

enum OrderType {
  B2C
  B2B
}

enum OrderStatus {
  PENDING
  CONFIRMED // B2B 확정 / 결제 완료
  CANCELLED
  REFUNDED
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  courseId   String? // 단건 강의 구매
  passPlanId String? // 아카데미 패스 구매
  quantity   Int       @default(1) // B2B: 수강생 수
  price      Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course     Course?   @relation(fields: [courseId], references: [id])
  passPlan   PassPlan? @relation(fields: [passPlanId], references: [id])
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique // INV-20250301-001
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  totalAmount Int
  taxAmount   Int           @default(0) // 부가세
  pdfUrl      String? // 생성된 PDF URL
  createdAt   DateTime      @default(now())
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ─── 찜 ───
model Wishlist {
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, courseId])
}

// ─── 후기·평점 (진도 80% 이상 또는 수료자만 작성) ───
model Review {
  id          String       @id @default(cuid())
  userId      String
  courseId    String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating      Int // 1~5
  content     String       @db.Text
  showName    Boolean      @default(false) // 실명 후기 동의. false 면 홍*동 처럼 가린다
  status      ReviewStatus @default(PUBLISHED)
  reportCount Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, courseId])
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN // 신고 검토 후 숨김
}

// ─── 실습·오프라인 일정 ───
model TrainingSession {
  id            String                @id @default(cuid())
  courseId      String?
  course        Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title         String
  region        String // 서울, 부산 ...
  location      String
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int
  note          String?               @db.Text
  registrations SessionRegistration[]
  createdAt     DateTime              @default(now())
}

model SessionRegistration {
  sessionId String
  userId    String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@id([sessionId, userId])
}

// ─── 기관(B2B) 과정 배정 · 직원 초대 ───
model CourseAssignment {
  id             String       @id @default(cuid())
  organizationId String
  courseId       String
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User         @relation("AssignmentLearner", fields: [userId], references: [id], onDelete: Cascade)
  dueAt          DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, courseId, userId])
}

model OrgInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  token          String       @unique
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
}

// ─── 정적 문서 (이용약관·개인정보처리방침·환불 규정). 어드민에서 수정 ───
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // terms, privacy, refund
  title     String
  content   String   @db.Text // HTML
  updatedAt DateTime @updatedAt
}

// ─── 바야다 인증 (정책값은 어드민에서 설정: 필수 강의·합격 점수·실기·유효기간·갱신 알림) ───
model CredentialProgram {
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  title                 String
  summary               String?
  description           String?                 @db.Text
  requiredCourseIds     String[] // 신청 전에 수료해야 하는 강의
  examPassingScore      Int                     @default(80) // 필기(시험) 합격 점수
  practicalRequired     Boolean                 @default(true) // 실기 평가 여부
  practicalPassingScore Int                     @default(80)
  validityMonths        Int? // null 이면 영구
  renewalNoticeDays     Int                     @default(30)
  criteria              String?                 @db.Text // 평가 기준 안내
  active                Boolean                 @default(false)
  applications          CredentialApplication[]
  credentials           Credential[]
  pathwaySteps          PathwayStep[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model CredentialApplication {
  id             String              @id @default(cuid())
  programId      String
  userId         String
  program        CredentialProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  user           User                @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  status         CredentialAppStatus @default(SUBMITTED)
  motivation     String?             @db.Text
  examScore      Int?
  practicalScore Int?
  evaluatorId    String?
  evaluator      User?               @relation("Evaluator", fields: [evaluatorId], references: [id])
  evaluatorNote  String?             @db.Text
  decisionNote   String?             @db.Text
  decidedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// 신청 → 평가 중 → 평가 완료(합격/불합격 판정) → 운영자 승인(발급) / 반려
enum CredentialAppStatus {
  SUBMITTED
  EVALUATING
  EVALUATED
  APPROVED
  REJECTED
}

model Credential {
  id                String            @id @default(cuid())
  number            String            @unique // BC-2026-000001
  programId         String
  userId            String
  program           CredentialProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt          DateTime          @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?
  renewalNotifiedAt DateTime?
  renewalEmailedAt  DateTime? // 갱신 안내 메일 발송 시각 (cron 이 한 번만 보낸다)
}

// ─── 아카데미 패스 (요금·기간·포함 범위는 어드민 설정) ───
model PassPlan {
  id            String         @id @default(cuid())
  name          String
  description   String?        @db.Text
  price         Int // 원
  durationDays  Int
  includes      ProductType[] // 무제한 수강 대상 상품 유형
  active        Boolean        @default(true)
  orderItems    OrderItem[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
}

model Subscription {
  id         String    @id @default(cuid())
  userId     String
  planId     String
  orderId    String?   @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       PassPlan  @relation(fields: [planId], references: [id])
  order      Order?    @relation(fields: [orderId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  canceledAt DateTime?
  createdAt  DateTime  @default(now())
}

// ─── 커리어 패스웨이 (국가·직종별 경로) ───
model Pathway {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  country    String // 미국, 아일랜드, 국내 ...
  jobRole    JobRole?
  summary    String?
  content    String?       @db.Text // 자격 경로 개요 (HTML)
  infoAsOf   DateTime? // 정보 기준일
  disclaimer String?       @db.Text // 법적 자문 아님 등 면책 고지
  coverImage String?
  published  Boolean       @default(false)
  order      Int           @default(0)
  steps      PathwayStep[]
  goals      PathwayGoal[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model PathwayStep {
  id                  String             @id @default(cuid())
  pathwayId           String
  pathway             Pathway            @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  order               Int
  title               String
  description         String?            @db.Text
  courseId            String?
  course              Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  credentialProgramId String?
  credentialProgram   CredentialProgram? @relation(fields: [credentialProgramId], references: [id], onDelete: SetNull)
}

model PathwayGoal {
  userId    String
  pathwayId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathway   Pathway  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, pathwayId])
}

// ─── 계정: 비밀번호 재설정·이메일 인증 토큰, 로그인 실패 기록, 소셜 로그인 연결 ───
enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// 메일로 보낸 1회용 토큰. 원문은 저장하지 않고 sha256 만 둔다
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// 로그인 실패 기록 (이메일+IP 기준 제한). 여러 인스턴스가 같이 보도록 DB 에 둔다
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
  @@index([createdAt])
}

// 카카오·구글 계정 연결 (학습자 사이트 전용)
model SocialAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // kakao | google
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}
