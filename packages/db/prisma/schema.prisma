generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 사용자 ───
model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  password       String // bcrypt hash
  role           Role          @default(STUDENT)
  status         UserStatus    @default(APPROVED) // 사내 가입 승인 (New User Approve 이관)
  jobRole        JobRole? // 대상 직군 (최초 로그인 시 수집)
  phone          String?
  legacyWpId     Int?          @unique // bestcareacademy.com wp_users.ID
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  enrollments    Enrollment[]
  progresses     Progress[]
  orders         Order[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

// 피그마 설계 택소노미 1차 축
enum JobRole {
  CAREGIVER // 요양보호사·간병인
  NURSE_AIDE // 간호조무사
  RN // 간호사
  PT // 방문운동사
  MANAGER // 센터 관리자
  OTHER
}

enum Role {
  ADMIN
  STUDENT
  ORG_ADMIN
  CONTENT_MANAGER // 콘텐츠 운영자
  CLINICAL_REVIEWER // 임상 리뷰어
  PARTNER_ADMIN // 외부 파트너 관리자
}

// ─── 기관 (B2B) ───
model Organization {
  id        String   @id @default(cuid())
  name      String
  bizNo     String? // 사업자등록번호
  contact   String? // 담당자 연락처
  isInternal Boolean @default(false) // 바야다 사내 조직. 소속 회원만 INTERNAL 강의를 본다
  users     User[]
  orders    Order[]
  createdAt DateTime @default(now())
}

// ─── 강의 ───
model Course {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String?       @db.Text
  summary      String? // 카드용 한 줄 소개
  thumbnail    String? // URL
  price        Int           @default(0) // 원 단위
  status       CourseStatus  @default(DRAFT)
  visibility   Visibility    @default(PUBLIC)
  productType  ProductType   @default(COURSE)
  level        Level?
  durationMin  Int? // 총 학습 시간(분)
  audiences    JobRole[] // 대상 직군
  objectives   String[] // 학습 목표
  featured     Boolean       @default(false) // 메인 신규·인기 큐레이션
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id])
  providerId   String?
  provider     Provider?     @relation(fields: [providerId], references: [id])
  sections     Section[]
  enrollments  Enrollment[]
  orderItems   OrderItem[]
  certificates Certificate[]
  reviewNote   String?       @db.Text // 승인 워크플로우 수정 요청 사유
  legacyWpId   Int?          @unique // wp_posts.ID (stm-courses)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// 사내 전용(직원 의무교육) vs 외부 공개
enum Visibility {
  PUBLIC
  INTERNAL
}

enum ProductType {
  COURSE // 단과
  TRACK // 스킬 트랙
  CERTIFICATION // 바야다 인증과정
  PATHWAY // 커리어 패스웨이
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ─── 제공 기관 (바야다 자체 + 외부 파트너) ───
model Provider {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  isPartner Boolean  @default(false)
  courses   Course[]
  createdAt DateTime @default(now())
}

// 승인 워크플로우 상태 머신 (피그마 04)
enum CourseStatus {
  DRAFT
  SUBMITTED // 승인 요청
  IN_REVIEW // 형식·품질 검토
  CLINICAL_REVIEW // 임상 근거 검토
  CHANGES_REQUESTED // 수정 요청
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  order   Int      @default(0)
  courses Course[]
}

// ─── 섹션 & 레슨 ───
model Section {
  id         String    @id @default(cuid())
  title      String
  order      Int
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures   Lecture[]
  legacyWpId Int?      @unique // stm_lms_curriculum_sections.id
}

model Lecture {
  id         String      @id @default(cuid())
  title      String
  order      Int
  type       LectureType @default(VIDEO)
  videoUrl   String? // 영상 URL (S3/R2)
  content    String?     @db.Text // TEXT 레슨 본문
  duration   Int? // 초 단위
  isFree     Boolean     @default(false) // 무료 미리보기
  sectionId  String
  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  quiz       Quiz?
  progresses Progress[]
  legacyWpId Int? // wp_posts.ID (stm-lessons / stm-quizzes). 같은 레슨이 여러 강의에 쓰여 unique 아님
}

enum LectureType {
  VIDEO
  TEXT
  QUIZ
}

// ─── 퀴즈 ───
model Quiz {
  id           String        @id @default(cuid())
  lectureId    String        @unique
  lecture      Lecture       @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  passingScore Int           @default(80) // %
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id         String       @id @default(cuid())
  quizId     String
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order      Int
  type       QuestionType @default(SINGLE)
  text       String       @db.Text
  options    Json // [{ text, correct }]
  legacyWpId Int? // stm-questions
}

enum QuestionType {
  SINGLE
  MULTI
  TRUE_FALSE
  FILL_GAP // 본문의 |정답| 을 빈칸으로
  KEYWORDS // 키워드 입력
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  user      User     @relation(fields: [userId], references: [id])
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int // %
  passed    Boolean
  createdAt DateTime @default(now())
}

// ─── 수강 ───
model Enrollment {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  user            User      @relation(fields: [userId], references: [id])
  course          Course    @relation(fields: [courseId], references: [id])
  progressPercent Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([userId, courseId])
}

// ─── 수료증 ───
model Certificate {
  id        String    @id @default(cuid())
  number    String    @unique // 공개 검증용 번호 BA-2026-000123
  userId    String
  courseId  String
  user      User      @relation(fields: [userId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id])
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  @@unique([userId, courseId])
}

// ─── 메인 배너 (노출 기간 필수) ───
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  linkUrl   String?
  startsAt  DateTime
  endsAt    DateTime
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── 감사 로그 ───
model AuditLog {
  id      String   @id @default(cuid())
  actorId String?
  action  String // course.submit, course.approve ...
  target  String // Course:ckxxx
  detail  Json?
  at      DateTime @default(now())

  @@index([target])
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  lectureId   String
  completed   Boolean   @default(false)
  completedAt DateTime?
  watchedSec  Int       @default(0) // 시청 초
  user        User      @relation(fields: [userId], references: [id])
  lecture     Lecture   @relation(fields: [lectureId], references: [id])
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lectureId])
}

// ─── 주문 & 빌링 ───
model Order {
  id             String        @id @default(cuid())
  orderNo        String        @unique // ORD-20250301-001
  userId         String
  organizationId String?
  user           User          @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  type           OrderType     @default(B2C)
  status         OrderStatus   @default(PENDING)
  totalAmount    Int           @default(0)
  items          OrderItem[]
  invoice        Invoice?
  createdAt      DateTime      @default(now())
}

enum OrderType {
  B2C
  B2B
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  courseId String
  quantity Int    @default(1) // B2B: 수강생 수
  price    Int
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id])
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique // INV-20250301-001
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  totalAmount Int
  taxAmount   Int           @default(0) // 부가세
  pdfUrl      String? // 생성된 PDF URL
  createdAt   DateTime      @default(now())
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}
